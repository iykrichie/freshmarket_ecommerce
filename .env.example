# APP_URL: The URL where this storefront instance is hosted.
APP_URL="http://localhost:3000"
PORT=3000

# White-Label Subscription Provisioning & First-Run Setup
# Set SETUP_REQUIRED="true" when shipping a fresh buyer package so the 1-time Setup Wizard launches automatically.
SETUP_REQUIRED="false"
SUBSCRIPTION_PLAN="growth"
SUBSCRIPTION_LICENSE_KEY="FM-GRW-TRIAL-2026"

# Optional Pre-Seeded Store Defaults (also configurable via `npm run init` or in-app Setup Wizard)
STORE_NAME="FreshMarket Global"
STORE_CURRENCY="GBP"
STORE_CURRENCY_SYMBOL="£"
STORE_PHONE="+44 20 7946 0912"
STORE_WHATSAPP="447911123456"
STORE_EMAIL="orders@freshmarketglobal.com"
FREE_DELIVERY_THRESHOLD=50

# Optional Gemini AI key (only required if enabling AI extensions)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
